# ============================================================
# MACOKASA environment configuration
#
# Values prefixed PUBLIC or listed under "client bundle" are written
# into public/config.js and are readable by anyone. Never place
# secrets there.
# ============================================================

# --- Client bundle (PUBLIC — safe to publish) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
PUBLIC_BASE_URL=https://macokasa.org

# Organisation contact details shown on the public website and
# legal pages. Leave blank to hide rather than show a placeholder.
MACOKASA_ORG_NAME=MACOKASA
MACOKASA_CONTACT_EMAIL=
MACOKASA_CONTACT_PHONE=
MACOKASA_CONTACT_ADDRESS=
MACOKASA_SAFETY_LINE=

# --- Server side only (SECRET — never add to the Render static site) ---
# Used by the Supabase edge function for membership reminders.
# SUPABASE_SERVICE_ROLE_KEY=
# SMS_PROVIDER_API_KEY=
# WHATSAPP_PROVIDER_TOKEN=
# SMTP_PASSWORD=

# --- REMOVED in the production release ---
# The following prototype variables no longer exist. Portal access is
# now Supabase Auth with per-user accounts and roles. Delete these
# from any Render environment where they are still set:
#   MACOKASA_STAFF_PASSWORD
#   MACOKASA_OWNER_PASSWORD
#   MACOKASA_PRINT_PASSWORD
#   MACOKASA_WEBADMIN_PASSWORD
